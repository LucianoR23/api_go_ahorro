
PORT=8080
ENV=dev
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://valuo:valuo_dev_pw@localhost:5433/valuo?sslmode=disable

# Migrations on startup. Off by default: in dev, run the migrate CLI by hand.
# On deploys (staging/prod) set MIGRATE_ON_START=true and point
# MIGRATE_DATABASE_URL at the schema-owner role; DATABASE_URL stays the
# DML-only runtime role. Required when MIGRATE_ON_START=true (no fallback).
MIGRATE_ON_START=false
MIGRATE_DATABASE_URL=

# Auth (generá uno random de 64 chars con: openssl rand -hex 32)
JWT_SECRET=cambiame-por-un-string-aleatorio-de-al-menos-32-chars

ALLOWED_ORIGINS=http://localhost:3005

RESEND_API_KEY=

# Product name in emails and the startup banner (plan 0.15b). Empty = Valuo.
# The *_FROM_EMAIL defaults are "<BRAND_NAME> <onboarding@resend.dev>".
BRAND_NAME=

# Timezone that decides "today", the current month and when the daily jobs run
# (plan 0.2). IANA name; default America/Argentina/Buenos_Aires.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Client IP (plan 0.6). TRUSTED_PROXIES: the reverse proxy network allowed to
# set X-Forwarded-For (empty in dev: trust nobody). CLOUDFLARE_RANGES defaults
# to Cloudflare's published edges (CF-Connecting-IP is believed only from them).
TRUSTED_PROXIES=
CLOUDFLARE_RANGES=

# Landing waitlist (plan B.5; contract valuo_web/docs/waitlist-contract.md).
# WAITLIST_SITE_URL: the landing (confirmation links go to /confirmar#token=).
# WAITLIST_ALLOWED_ORIGINS defaults to WAITLIST_SITE_URL. Without
# TURNSTILE_SECRET_KEY the captcha is skipped in dev and every sign-up is
# refused with ENV=prod. API_PUBLIC_URL builds the one-click unsubscribe link.
WAITLIST_SITE_URL=http://localhost:3000
WAITLIST_ALLOWED_ORIGINS=
WAITLIST_BRAND_NAME=
WAITLIST_FROM_EMAIL=
WAITLIST_CONTACT_EMAIL=
TURNSTILE_SECRET_KEY=
API_PUBLIC_URL=http://localhost:8080
REPORT_FROM_EMAIL=
INVITE_FROM_EMAIL=
PASSWORD_RESET_FROM_EMAIL=
VERIFICATION_FROM_EMAIL=

# URL pública del frontend. Se usa para armar los links de invitación.
APP_BASE_URL=http://localhost:3005

# Google Sign-In: OAuth 2.0 web client ID (same as the front's NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# Empty = /auth/google responds 500.
GOOGLE_OAUTH_CLIENT_ID=

# Web push (go run ./cmd/vapidgen). Empty keys = push off. With keys set,
# VAPID_SUBJECT (mailto:... or https://...) is required.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Lemy Support ──────────────────────────────────────────────────────────────
# Servicio de soporte centralizado. La API key se saca del panel
# https://soporte.lemydev.com (Apps → Nueva app) y se muestra UNA SOLA VEZ.
# Server-side only — NUNCA exponer al front ni prefijar con NEXT_PUBLIC_.
# Vacía = módulo deshabilitado (endpoints /support/* responden 503).
# Registrá la app con allowed_origins VACÍO (las llamadas salen server-side).
SOPORTE_API_URL=http://localhost:8081
SOPORTE_API_KEY=

# ── Error monitoring (plan 0.12) ──────────────────────────────────────────────
# GlitchTip (Sentry compatible) project DSN. Empty = no reporting. Every ERROR
# log line and every handler panic becomes an event, scrubbed of e-mails, IDs,
# tokens and numbers. GLITCHTIP_ENVIRONMENT tells staging from prod in the
# dashboard (both run with ENV=prod); defaults to ENV.
GLITCHTIP_DSN=
GLITCHTIP_ENVIRONMENT=

# ── Crypto prices (plan 5.6) ──────────────────────────────────────────────────
# CoinGecko demo key (free, from coingecko.com/en/developers/dashboard). Prices
# bitcoin and ether for "Ver en", asked at most once an hour. Empty = no BTC/ETH.
COINGECKO_API_KEY=

# ── Import by forwarded email (plan 3.5) ─────────────────────────────────────
# All three set turn it on; empty = /inbound/* responds 503. The Cloudflare
# Email Worker (workers/inbound-email) gets the same INBOUND_HMAC_KEY.
#   INBOUND_DOMAIN: host of the addresses (staging: in-next.valuo.ar)
#   INBOUND_HMAC_KEY: base64, 32+ random bytes   (openssl rand -base64 32)
#   INBOUND_ENC_KEY:  base64, exactly 32 bytes    (openssl rand -base64 32)
INBOUND_DOMAIN=
INBOUND_HMAC_KEY=
INBOUND_ENC_KEY=

# ── AI layer (plan 8.1) ───────────────────────────────────────────────────────
# Off unless AI_ENABLED=true. Claude (Haiku 5.5) serves every task except
# audio, which goes to Gemini because Claude takes no audio input.
# Anthropic key: from the Console organization linked to the Claude Max plan
# (its monthly API credits pay for it), one workspace per environment with
# its own spend limit. Gemini key: aistudio.google.com. Staging may use the
# free tier (test data only); production must use the paid tier, because on
# the free tier Google may use the data to improve its products.
AI_ENABLED=false
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional overrides (defaults in internal/config/env.go):
#   AI_ROUTES=default=anthropic:claude-haiku-5-5:low,summarize=anthropic:claude-haiku-5-5:medium,parse_audio=gemini:gemini-3.5-flash-lite:minimal
#   AI_PRICES=claude-haiku-5-5=0.10/0.50,gemini-3.5-flash-lite=0.30/2.50   (USD per million tokens: in/out[/audio])
#   AI_DISABLED_TASKS=parse_audio,parse_receipt
# Guardrails (plan §8.2): global daily budget, then per person.
AI_DAILY_BUDGET_USD=3
AI_USER_DAILY_USD=0.05
AI_USER_PER_MINUTE=10
AI_USER_PER_DAY=100
