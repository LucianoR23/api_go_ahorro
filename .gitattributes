# ─── DEFAULT ───────────────────────────────────────────────
# Todo texto → LF. Git detecta automáticamente si es texto o binario.
* text=auto eol=lf

# ─── SOURCE CODE ───────────────────────────────────────────
# Go
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf

# JavaScript / TypeScript / Web
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.vue   text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf

# Python
*.py    text eol=lf
*.pyi   text eol=lf

# ─── CONFIG / DATA ─────────────────────────────────────────
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
*.md        text eol=lf
*.mdx       text eol=lf
*.txt       text eol=lf
*.sql       text eol=lf
*.graphql   text eol=lf
*.gql       text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
Makefile    text eol=lf
*.sh        text eol=lf

# ─── WINDOWS-SPECIFIC (mantener CRLF si los usás) ──────────
# Descomentá si tenés scripts .bat o .ps1 en el repo
# *.bat   text eol=crlf
# *.cmd   text eol=crlf
# *.ps1   text eol=crlf

# ─── BINARIOS (sin conversión) ─────────────────────────────
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
# SVG es texto/XML
*.svg   text eol=lf   
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.7z    binary
*.mp4   binary
*.mp3   binary
*.webm  binary